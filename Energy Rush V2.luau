			for i = 1, 10 do
				sphereMK(1.5,2,"Add",torso.CFrame*CFrame.Angles(math.rad(math.random(-360,360)),math.rad(math.random(-360,360)),math.rad(math.random(-360,360))),1,1,25,-.01,Color3.new(r/255,g/255,b/255),0,true)
			end
