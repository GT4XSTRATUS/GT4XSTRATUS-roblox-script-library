			chatfunc("Either you missed, or you just randomly pressed a button, "..plr.Name..".",colror(r/255,g/255,b/255))
		end
	end
	if targetted ~= nil then
		attack = true
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		targetted.Head.Anchored = true
		local originalpos = root.CFrame
		RootPart.CFrame = targetted.Head.CFrame * CFrame.new(0,-2,4)
		CFuncs["Sound"].Create("rbxassetid://235097614",root,1,3)
