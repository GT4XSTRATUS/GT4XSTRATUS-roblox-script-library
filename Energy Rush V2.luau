	else
		CFuncs["Sound"].Create("rbxassetid://7649721525",hed,1,1);
		local chcne=math.random(1,4)
		if chcne==1 then
			chatfunc("Your aim is trash, "..plr.Name..".",colror(r/255,g/255,b/255))
		elseif chcne==2 then
			chatfunc("Are you even aiming at anyone, "..plr.Name.."?",colror(r/255,g/255,b/255))
		elseif chcne==3 then
			chatfunc("You can do better at aiming than THAT, "..plr.Name..".",colror(r/255,g/255,b/255))
